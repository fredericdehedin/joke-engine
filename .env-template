# Copy this file to `.env` in the project root, then fill in your Anthropic
# API key below. `.env` is gitignored and never committed - this template is
# the only one of the two that's safe to commit.
#
#   cp .env-template .env
#
# Required: your Anthropic API key.
ANTHROPIC_API_KEY=

# Optional: defaults are already the most cost-efficient available.
# Override only if you want a different model/effort level.
JOKE_ENGINE_MODEL=claude-haiku-4-5
JOKE_ENGINE_EFFORT=low
